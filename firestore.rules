rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Todos os dados do app ficam em users/{uid}/... e só o dono acessa.
    match /users/{userId}/{document=**} {
      allow read, write: if isOwner(userId);
    }

    // TEMPORÁRIO: leitura das coleções antigas (na raiz, sem dono) para a
    // importação feita em "Dados do usuário > Importar dados antigos".
    // Remova este bloco depois de migrar os dados.
    match /{legacyCollection}/{docId} {
      allow read: if request.auth != null
        && legacyCollection in ['accounts', 'transactions', 'tags',
                                'shopping_categories', 'shopping_items',
                                'shopping_purchase_lists'];
    }
  }
}
